<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive icon's layers are 108 dp; the launcher shows the inner
     72 dp and masks it to its shape. The full-bleed square art fills that
     72 dp (an 18 dp inset, 1/6 of each side), so the mask trims only its
     corners, the way macOS masks the same art. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_art"
    android:inset="18dp" />
